# Host :443 — TLS router (numz-assistant-https container)
# HTTPS terminates here; proxy directly to app ports (not gateway :80 — that redirects to HTTPS).
# Deploy: bash scripts/deploy-https-router.sh && bash scripts/deploy-numzlab-tls.sh

{
	auto_https off
}

# assistant.numzlab — MIGRATED to assistant.lab.numz.site (2026-07-17).
# numzlab.tail2839ee.ts.net kept — bare Tailscale MagicDNS hostname, not an
# app-specific route to migrate away. Updated to point at the new production
# build (port 3103, Dockerfile.production) instead of the old Vite dev
# server (:5173).
numzlab.tail2839ee.ts.net {
	tls /certs/cert.pem /certs/key.pem
	reverse_proxy 127.0.0.1:3103
}

