{
  "name": "ai-assistant",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node server/server.js",
    "dev:audio": "node scripts/run-audio-server.js",
    "dev:all": "concurrently -n web,api -c blue,green \"npm run dev\" \"npm run dev:api\"",
    "lecture:transcribe": "node scripts/run-lecture-transcribe.js",
    "lecture:notes": "node scripts/lecture-notes.js",
    "speech:process": "node scripts/run-speech-process.js",
    "speech:notes": "node scripts/speech-notes.js",
    "outbox:status": "node scripts/run-outbox.js status",
    "outbox:replay": "node scripts/run-outbox.js replay",
    "test": "node --test server/meetings/*.test.js server/persistence/*.test.js server/auth/*.test.js server/api/*.test.js",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/server.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@picovoice/porcupine-web": "^3.0.3",
    "@picovoice/web-voice-processor": "^4.0.9",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "three": "^0.170.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^6.0.1"
  }
}
