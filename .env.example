PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
AI_PROVIDER=placeholder
# AI_PROVIDER=deepseek
# AI_API_KEY=your-api-key
# AI_MODEL=deepseek-v4-flash
# AI_BASE_URL=https://api.deepseek.com
# Claude (an API key from console.anthropic.com; a Claude subscription does not include one):
# AI_PROVIDER=anthropic
# AI_API_KEY=sk-ant-...                (put it in .env.secrets)
# AI_MODEL=claude-opus-5-5             (claude-sonnet-5-5 is the faster, cheaper step down)
# AI_EFFORT=medium                     (low | medium | high | xhigh | max | off)
# AI_MAX_TOKENS=64000
# AI_FALLBACKS=off                     (only to turn off the refusal fallback)

# Local audio sidecar (Phase 1)
STT_BACKEND=local
# Host dev: http://127.0.0.1:8765  |  Docker Compose: http://audio:8765 (set in docker-compose.yml)
AUDIO_SERVICE_URL=http://127.0.0.1:8765
AUDIO_SERVICE_TIMEOUT_MS=60000
AUDIO_HEALTH_CACHE_MS=30000

# Persistent Speech / Meeting Intelligence database
SPEECH_DATABASE_PATH=./data/speech.sqlite
# Server ORIGIN (no /api/v1) used by the live speech sidecar to persist final segments.
# Empty = the live transport never persists. Example: http://127.0.0.1:3103 for production.
MEETING_API_URL=http://127.0.0.1:3002

# Python VAD tuning (audio sidecar)
# VAD_MIN_SPEECH_MS=250
# VAD_MIN_SILENCE_MS=300
# VAD_SPEECH_PAD_MS=80

# Cloud STT fallback (when STT_BACKEND=cloud)
# STT_API_KEY=
# STT_BASE_URL=
# STT_MODEL=whisper-1

# Browser Porcupine wake (Vite — prefix VITE_)
# VITE_PICOVOICE_ACCESS_KEY=
# VITE_PORCUPINE_KEYWORD_PUBLIC_PATH=/porcupine/numz_en_wasm_v3_0_0.ppn
# VITE_PORCUPINE_MODEL_PUBLIC_PATH=/porcupine/porcupine_params_en.pv

# Tests only: do not read .env or .env.secrets (so a test uses the configuration it passes in).
# NUMZ_SKIP_ENV_FILES=1

# Dev server host allow-list and hot reload, and the helper scripts' URLs. Set to this machine's Tailscale
# name and address in your private .env; leave unset to allow only localhost.
# TAILSCALE_HOST=your-machine.your-tailnet.ts.net
# TAILSCALE_IP=100.x.y.z

# Course materials (Study panel). Every size is in MB of text; a missing or zero value means the default shown.
# A document over ACADEMIC_ASYNC_THRESHOLD_KB is stored at once and cut and indexed in the background (status processing, ready or failed, with Retry).
# The database keeps the text three times over (document, passages, search index): a 100 MB document takes about 370 MB on disk.
# ACADEMIC_MAX_DOCUMENT_MB=100
# ACADEMIC_MAX_BATCH_FILES=50
# ACADEMIC_MAX_PERSON_MB=500
# ACADEMIC_MAX_DOCS_PER_COURSE=100
# ACADEMIC_MAX_DOCS_PER_PERSON=300
# ACADEMIC_MAX_CHUNKS_PER_DOCUMENT=150000
# ACADEMIC_ASYNC_THRESHOLD_KB=1024
