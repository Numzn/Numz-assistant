PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
AI_PROVIDER=placeholder
# AI_PROVIDER=deepseek
# AI_API_KEY=your-api-key
# AI_MODEL=deepseek-v4-flash
# AI_BASE_URL=https://api.deepseek.com

# Local audio sidecar (Phase 1)
STT_BACKEND=local
# Host dev: http://127.0.0.1:8765  |  Docker Compose: http://audio:8765 (set in docker-compose.yml)
AUDIO_SERVICE_URL=http://127.0.0.1:8765
AUDIO_SERVICE_TIMEOUT_MS=60000
AUDIO_HEALTH_CACHE_MS=30000

# Persistent Speech / Meeting Intelligence database
SPEECH_DATABASE_PATH=./data/speech.sqlite
# Optional internal URL used by the Python live-speech transport to persist
# final segments, e.g. http://127.0.0.1:3002
MEETING_API_URL=http://127.0.0.1:3002

# Python VAD tuning (audio sidecar)
# VAD_MIN_SPEECH_MS=250
# VAD_MIN_SILENCE_MS=300
# VAD_SPEECH_PAD_MS=80

# Cloud STT fallback (when STT_BACKEND=cloud)
# STT_API_KEY=
# STT_BASE_URL=
# STT_MODEL=whisper-1

# Browser Porcupine wake (Vite — prefix VITE_)
# VITE_PICOVOICE_ACCESS_KEY=
# VITE_PORCUPINE_KEYWORD_PUBLIC_PATH=/porcupine/numz_en_wasm_v3_0_0.ppn
# VITE_PORCUPINE_MODEL_PUBLIC_PATH=/porcupine/porcupine_params_en.pv
