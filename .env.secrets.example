# Copy to .env.secrets and fill in your keys (never commit .env.secrets)
AI_API_KEY=your-deepseek-api-key-here

# Optional: Picovoice wake word (https://console.picovoice.ai/)
# VITE_PICOVOICE_ACCESS_KEY=your-picovoice-access-key

# Meeting persistence (server/auth/meetingAuth.js). Each value must be at least 32 random characters.
# Admin token: lifecycle, reads, and ticket minting. Keep it off the browser.
# MEETING_API_TOKEN=
# Signs meeting tickets handed to the live speech client. Changing it revokes every outstanding ticket.
# MEETING_TICKET_SECRET=
# Lets the browser's Meeting button start a meeting (at least 12 characters; a long random string is best).
# It allows starting a new meeting and nothing else, and wrong guesses are throttled. Leave unset to
# disable starting meetings from the browser. Changing it needs a server restart.
# MEETING_LAUNCH_CODE=

# Access to the assistant (chat, voice, conversation history; server/auth/assistantAuth.js).
# Unset = the assistant is open to anyone who can reach this server (how it behaved before this existed).
# Set it to a long random string, at least 12 characters: people type it once and get a session cookie.
# A value shorter than 12 characters LOCKS the assistant until fixed (it never falls back to open).
# Changing it signs everyone out. Needs a server restart.
# ASSISTANT_ACCESS_CODE=
# How long a login lasts, in seconds (default 43200 = 12 hours).
# ASSISTANT_SESSION_TTL_S=43200
