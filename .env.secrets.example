# Copy to .env.secrets and fill in your keys (never commit .env.secrets)
AI_API_KEY=your-deepseek-api-key-here

# Optional: Picovoice wake word (https://console.picovoice.ai/)
# VITE_PICOVOICE_ACCESS_KEY=your-picovoice-access-key

# Meeting persistence (server/auth/meetingAuth.js). Each value must be at least 32 random characters.
# Admin token: lifecycle, reads, and ticket minting. Keep it off the browser.
# MEETING_API_TOKEN=
# Signs meeting tickets handed to the live speech client. Changing it revokes every outstanding ticket.
# MEETING_TICKET_SECRET=
# Lets the browser's Meeting button start a meeting (at least 12 characters; a long random string is best).
# It allows starting a new meeting and nothing else, and wrong guesses are throttled. Leave unset to
# disable starting meetings from the browser. Changing it needs a server restart.
# MEETING_LAUNCH_CODE=

# Access to the assistant (chat, voice, conversation history; server/auth/assistantAuth.js).
# Unset = the assistant is open to anyone who can reach this server (how it behaved before this existed).
# Set it to a long random string, at least 12 characters: people type it once and get a session cookie.
# A value shorter than 12 characters LOCKS the assistant until fixed (it never falls back to open).
# Changing it signs everyone out. Needs a server restart.
# ASSISTANT_ACCESS_CODE=
# How long a login lasts, in seconds (default 43200 = 12 hours).
# ASSISTANT_SESSION_TTL_S=43200

# Smart Camera (camera.html; server/camera/vision.js). Pictures of a question are sent to this vision provider to be
# read, and are not kept. It is configured only when the provider, key and model are ALL set. Each picture is a paid
# call. There is deliberately no default model: it decides the cost and how well glare or a moire pattern is read.
# Prove it works without a phone:  node scripts/camera-vision-check.js
# CAMERA_VISION_PROVIDER=openai           # or: anthropic, or openai-compatible (any other service with the same protocol)
# CAMERA_VISION_API_KEY=…
# CAMERA_VISION_MODEL=…                   # a model that accepts pictures
# CAMERA_VISION_BASE_URL=…                # optional for openai and anthropic (a gateway); required for openai-compatible
# CAMERA_VISION_REASONING_EFFORT=low      # optional, openai only: minimal | low | medium | high (less thinking = faster, cheaper)

# ---- NUMZ AI 2.0: each person signs in with their own Google account, through NUMZLAB (docs/ai-identity.md) ----------------------
# ASSISTANT_AUTH_MODE=code    the one shared access code above (the default, and the way back)
# ASSISTANT_AUTH_MODE=broker  per-person sign-in, sessions, private conversations, usage limits
# Where the app lives: the site address (no path) and the base path. PUBLIC_BASE_PATH is set in docker-compose.production.yml.
# PUBLIC_ORIGIN=https://lab.numz.site
# The sign-in broker (numzlab-auth). The secret is written here by `auth-admin.sh broker-client add numz-ai --redirect
# https://lab.numz.site/ai/auth/callback --write-env /srv/projects/Numz-assistant/.env.secrets`; it is never shown.
# NUMZLAB_BROKER_URL=http://host.docker.internal:18792
# NUMZLAB_BROKER_CLIENT_ID=numz-ai
# NUMZLAB_BROKER_CLIENT_SECRET=
# A staged roll-out: only these NUMZLAB user ids (comma list; see `auth-admin.sh users`) may sign in. Empty = everyone NUMZLAB approves.
# AI_ALLOWED_EXTERNAL_IDS=
# Sessions (seconds): idle limit and total lifetime; how often NUMZLAB is asked whether a person is still approved; how long the last
# answer stands if NUMZLAB cannot be reached (after that, access stops).
# AI_SESSION_IDLE_S=3600
# AI_SESSION_MAX_S=28800
# AI_REVALIDATE_S=60
# AI_REVALIDATE_GRACE_S=600
# Limits and cost control (server/usage, server/auth/rolePolicy.js). Starting points to tune from `node server/cli/aiAdmin.js usage`.
# AI_QUOTA_OVERRIDES={"viewer":{"chatPerDay":100,"visionPerDay":30,"sttSecondsPerDay":1800,"perMinute":30,"concurrent":2}}
# AI_MAX_CONCURRENT=8                  model calls at once, in all
# AI_CALL_TIMEOUT_MS=60000             a model call that outlasts this is stopped
# AI_DAILY_COST_LIMIT_USD_PER_USER=    spending thresholds (need the prices below); warned at 80%, refused at 100%
# AI_DAILY_COST_LIMIT_USD=
# AI_MONTHLY_COST_LIMIT_USD=
# AI_PRICE_INPUT_PER_MTOK=             US dollars per million tokens, from your provider's price list
# AI_PRICE_OUTPUT_PER_MTOK=
# AI_PRICE_VISION_INPUT_PER_MTOK=
# AI_PRICE_VISION_OUTPUT_PER_MTOK=
# AI_PRICE_STT_PER_MINUTE=
# AI_KILL_SWITCH=on                    stop every AI call at once (also: node server/cli/aiAdmin.js pause)
# STT_MAX_BYTES=6291456                the longest recording accepted
# AI_STREAM_USAGE=off                  if a provider rejects asking for token counts when streaming

# The speech service answers only callers that hold this key (24+ random characters). The speech service and this app both read it from
# THIS file, so one line serves both. Set it, restart the speech service when no meeting is live, then recreate this app.
# AUDIO_SERVICE_KEY=
# AUDIO_REQUIRE_KEY=1                  (speech service) refuse to start without the key
